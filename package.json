{
  "name": "connect-messenger",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-all.cjs",
    "check:architecture": "node scripts/check-architecture.cjs",
    "check:edge": "deno check --frozen --lock=supabase/deno.lock --config supabase/deno.json supabase/functions/*/index.ts",
    "test:e2e": "node scripts/test-all.cjs --e2e",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.0",
    "firebase-admin": "^13.0.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tus-js-client": "4.3.1",
    "tweetnacl": "1.0.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@roamhq/wrtc": "0.10.0",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/web-push": "^3.6.4",
    "playwright-core": "1.58.2",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "overrides": {
    "postcss": "8.5.23",
    "uuid@<11.1.1": "11.1.1"
  }
}
